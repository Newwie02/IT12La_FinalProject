# --- Mobile app (read by Expo; EXPO_PUBLIC_* vars are inlined into the bundle) ---

# Full API base URL. Leave unset to auto-detect the machine's LAN IP from
# Metro (recommended — it keeps working when DHCP changes your address).
# Set it only if auto-detection can't work (e.g. running with --tunnel).
# EXPO_PUBLIC_API_URL=http://10.189.139.146:8080/api

# API port used when building the URL from the detected host.
# EXPO_PUBLIC_API_PORT=8080

# --- API server (read by `pnpm server` / `pnpm db:setup`) ---
# Defaults match a stock XAMPP install, so these can stay commented out.
# 8080 is used instead of 5000 because it's already open in this machine's
# firewall (firewalld: 8000, 8080, 8081 are allowed; 5000 is not).
# API_PORT=8080
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=gigmatch
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=30d
